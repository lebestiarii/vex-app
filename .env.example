# Vex Build & Environment Profile Template
# Copy to .env (never commit .env!) when building or testing environment-specific defaults.
# Note: End-user runtime settings live in ~/.vex/config.json.

# Target environment label: local | qa | prod
VEX_ENV=local

# Optional build-time metadata overrides (injected via -ldflags)
VEX_APP_NAME=Vex
VEX_APP_VERSION=0.2.0
VEX_UPDATE_FEED_URL=

# Optional isolated data directory for testing without touching ~/.vex
VEX_DATA_DIR=/tmp/vex-dev

# Optional default MCP HTTP bind address (use 'off' to disable)
VEX_MCP_ADDR=127.0.0.1:17380

# Optional default global shortcut accelerator
VEX_HOTKEY=Ctrl+Shift+B
